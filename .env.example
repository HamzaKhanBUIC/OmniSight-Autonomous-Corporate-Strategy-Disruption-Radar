# Copy to .env and fill in. Never commit .env. agent_runtime.py loads this file.

# LLM (at least one). Groq is tried first, Gemini is the fallback.
GROQ_API_KEY=
GEMINI_API_KEY=

# Bright Data. Without a key the agent runs in simulation mode and the LLM
# invents the data instead of using live web results.
BRIGHT_DATA_API_KEY=
# Zone names; empty means serp_api1 / web_unlocker1
BRIGHT_DATA_SERP_ZONE=
BRIGHT_DATA_UNLOCKER_ZONE=

# Speechmatics batch transcription (optional, for audio)
SPEECHMATICS_API_KEY=

# TLS is always verified. If your network intercepts TLS (corporate proxy,
# antivirus), point this at a PEM CA bundle that includes its root CA.
SSL_CERT_FILE=

# The settings below are read by server.py from the process environment
# (shell or hosting dashboard), not from .env:
#   HOST          default 127.0.0.1; set 0.0.0.0 only when deploying (render.yaml does)
#   PORT          default 8000
#   AUDIO_MAX_MB  max audio upload/download size, default 50
#   AUDIO_DIR     where audio is stored, default ./temp_audio (outside web/)
